{
  "name": "openvault",
  "version": "0.2.0",
  "description": "OpenCode as an Obsidian sidebar AI collaborator",
  "main": "main.js",
  "scripts": {
    "prepare": "lefthook install",
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:prod"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "lefthook": "^2.2.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.5"
  }
}
