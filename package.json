{
  "name": "openvault",
  "version": "0.2.0",
  "description": "OpenCode as an Obsidian sidebar AI collaborator",
  "main": "main.js",
  "scripts": {
    "prepare": "lefthook install",
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "lefthook": "^2.2.2",
    "obsidian": "^1.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.5"
  }
}
